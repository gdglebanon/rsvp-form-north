rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read access for the universities list
    match /universities/{university} {
      allow read: if true;
      allow write: if false; // Nobody should be writing to this collection from the client
    }

    // Allow users to create, read, and update their own profile
    match /profiles/{userId} {
      allow read, update, create: if request.auth != null && request.auth.uid == userId;
    }
  }
}